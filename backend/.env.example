PORT=5000
SUPABASE_URL=https://your-project.supabase.co

# Supabase Keys
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS Configuration (pisahkan dengan koma jika lebih dari satu origin)
CORS_ORIGIN=https://<domain-kost-anda>

# Domain email sintetik untuk Staff & Admin
STAFF_EMAIL_DOMAIN=staff.kost.noud.id

# n8n Webhook Configuration
# Mode Test: https://n8n.noud.web.id/webhook-test/kostChatbotz
# Mode Production: https://n8n.noud.web.id/webhook/kostChatbotz
N8N_WEBHOOK_CHATBOT=https://n8n.noud.web.id/webhook-test/kostChatbotz
N8N_WEBHOOK_DISPATCH_TOKEN=https://n8n.yourdomain.com/webhook/dispatch-electricity-token
N8N_WEBHOOK_INVOICE_REMINDER=https://n8n.yourdomain.com/webhook/invoice-reminder
N8N_WEBHOOK_PAYMENT_RECEIPT=https://n8n.yourdomain.com/webhook/payment-receipt

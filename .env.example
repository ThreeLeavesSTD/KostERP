# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# n8n Webhook Endpoints for WhatsApp Automation
N8N_WEBHOOK_DISPATCH_TOKEN=https://n8n.yourdomain.com/webhook/dispatch-electricity-token
N8N_WEBHOOK_INVOICE_REMINDER=https://n8n.yourdomain.com/webhook/invoice-reminder
N8N_WEBHOOK_PAYMENT_RECEIPT=https://n8n.yourdomain.com/webhook/payment-receipt

# App Settings
NEXT_PUBLIC_APP_NAME="ERP Kost Pro"

# Backend & CORS Configuration
CORS_ORIGIN=https://<domain-kost-anda>


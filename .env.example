# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# n8n Webhook Endpoints for WhatsApp & Chatbot Automation
NEXT_PUBLIC_N8N_WEBHOOK_CHATBOT=https://n8n.noud.web.id/webhook/kostChatbotz
N8N_WEBHOOK_CHATBOT=https://n8n.noud.web.id/webhook/kostChatbotz
N8N_WEBHOOK_DISPATCH_TOKEN=https://n8n.yourdomain.com/webhook/dispatch-electricity-token
NEXT_PUBLIC_N8N_WEBHOOK_DISPATCH_TOKEN=https://n8n.yourdomain.com/webhook/dispatch-electricity-token
N8N_WEBHOOK_INVOICE_REMINDER=https://n8n.yourdomain.com/webhook/invoice-reminder
NEXT_PUBLIC_N8N_WEBHOOK_INVOICE_REMINDER=https://n8n.yourdomain.com/webhook/invoice-reminder
N8N_WEBHOOK_PAYMENT_RECEIPT=https://n8n.yourdomain.com/webhook/payment-receipt
NEXT_PUBLIC_N8N_WEBHOOK_PAYMENT_RECEIPT=https://n8n.yourdomain.com/webhook/payment-receipt

# App Settings
NEXT_PUBLIC_APP_NAME="ERP Kost Pro"

# Backend API is deployed as a Netlify Function with the frontend.
# Leave unset to use /api in production and localhost:5000/api locally.
# Set NEXT_PUBLIC_BACKEND_URL=/backend/api only if overriding the production default.
# NEXT_PUBLIC_BACKEND_URL=/backend/api
CORS_ORIGIN=https://<nama-site>.netlify.app

# Domain email sintetik untuk Staff & Admin
NEXT_PUBLIC_STAFF_EMAIL_DOMAIN=staff.kost.noud.id


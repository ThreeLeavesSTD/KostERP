    {
      "id": "a00070c2-5cd4-4cee-8238-b27cc97c7942",
      "name": "Normalisasi Pesan",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        272,
        384
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "chat",
              "name": "chatInput",
              "type": "string",
              "value": "={{ String($json.body?.chatInput ?? $json.body?.message ?? $json.body?.input ?? $json.body?.body?.chatInput ?? '').trim() }}"
            },
            {
              "id": "session",
              "name": "sessionId",
              "type": "string",
              "value": "={{ 'kost-erp:' + ((typeof ($json.body?.sessionId ?? $json.body?.session_id) === 'string' && ($json.body?.sessionId ?? $json.body?.session_id).trim() && ($json.body?.sessionId ?? $json.body?.session_id) !== 'kost-concierge-web-session') ? ($json.body?.sessionId ?? $json.body?.session_id).trim().slice(0,200) : 'request-' + $execution.id) }}"
            },
            {
              "id": "property",
              "name": "propertyHint",
              "type": "string",
              "value": "={{ String($json.body?.context?.property_id ?? $json.body?.context?.propertyId ?? '').slice(0,100) }}"
            },
            {
              "id": "date",
              "name": "receivedAt",
              "type": "string",
              "value": "={{ $now.setZone('Asia/Bangkok').toISO() }}"
            }
          ]
        }
      }
    },
    {
      "id": "c0c94c0c-3cb1-492d-b4d2-239bccf89d17",
      "name": "Pesan Valid",
